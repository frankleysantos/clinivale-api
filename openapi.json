  "info": {
    "title": "Clinivale API",
    "description": "Documentação OpenAPI da Clinivale API (Gerada Automaticamente)",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Maria Souza",
            "description": "Nome do usuário"
          },
          "password": {
            "type": "string",
            "example": "123456",
            "description": "Senha do usuário"
          },
          "email": {
            "type": "string",
            "example": "maria@clinivale.com",
            "description": "E-mail do usuário"
          },
          "client_id": {
            "type": "number",
            "example": 1,
            "description": "ID do cliente a ser associado (opcional)"
          },
          "role_ids": {
            "example": [
              1,
              2
            ],
            "description": "IDs das roles/perfis a serem associadas",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "name",
          "password",
          "email"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {}
      },
      "PermissionDto": {
        "type": "object",
        "properties": {
          "controller": {
            "type": "string",
            "example": "PatientController",
            "description": "Nome do controller"
          },
          "method": {
            "type": "string",
            "example": "create",
            "description": "Nome do método ou ação"
          }
        },
        "required": [
          "controller",
          "method"
        ]
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "ADMIN",
            "description": "Nome do papel/permissão"
          },
          "permissions": {
            "example": [
              {
                "controller": "PatientController",
                "method": "create"
              }
            ],
            "description": "Lista de permissões",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionDto"
            }
          },
          "client_id": {
            "type": "number",
            "example": 1,
            "description": "ID do cliente vinculado à role (opcional)"
          }
        },
        "required": [
          "name",
          "permissions"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "ADMIN",
            "description": "Nome do papel/permissão"
          },
          "permissions": {
            "example": [
              {
                "controller": "PatientController",
                "method": "create"
              }
            ],
            "description": "Lista de permissões",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PermissionDto"
            }
          },
          "client_id": {
            "type": "number",
            "example": 1,
            "description": "ID do cliente vinculado à role (opcional)"
          }
        }
      },
      "CreateAuthDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@clinivale.com",
            "description": "E-mail do usuário"
          },
          "password": {
            "type": "string",
            "example": "123456",
            "description": "Senha do usuário"
          },
          "client_id": {
            "type": "number",
            "example": 1,
            "description": "ID do cliente/clínica selecionado"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateClientDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "ID do cliente"
          },
          "name": {
            "type": "string",
            "example": "Clinica Exemplo",
            "description": "Nome do cliente ou empresa"
          },
          "cpf": {
            "type": "string",
            "example": "12345678900",
            "description": "CPF do cliente (Pessoa Física)"
          },
          "cnpj": {
            "type": "string",
            "example": "12345678000199",
            "description": "CNPJ do cliente (Pessoa Jurídica)"
          },
          "type": {
            "type": "string",
            "enum": [
              "FISICA",
              "JURIDICA"
            ],
            "example": "FISICA",
            "description": "Tipo do cliente"
          },
          "cellphone": {
            "type": "string",
            "example": "11999999999",
            "description": "Telefone ou celular"
          },
          "city": {
            "type": "string",
            "example": "São Paulo",
            "description": "Cidade"
          },
          "state": {
            "type": "string",
            "example": "SP",
            "description": "Estado (UF)"
          },
          "email": {
            "type": "string",
            "example": "contato@clinicaexemplo.com",
            "description": "E-mail do cliente"
          },
          "status": {
            "type": "string",
            "enum": [
              "ATIVO",
              "INATIVO"
            ],
            "example": "ATIVO",
            "description": "Status do cliente"
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "UpdateClientDto": {
        "type": "object",
        "properties": {}
      },
      "CreatePatientDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "ID do paciente"
          },
          "client_id": {
            "type": "number",
            "example": 1,
            "description": "ID do cliente vinculado ao paciente (opcional; utiliza cliente do usuário logado por padrão)"
          },
          "name": {
            "type": "string",
            "example": "João da Silva",
            "description": "Nome completo do paciente"
          },
          "cpf": {
            "type": "string",
            "example": "52998224725",
            "description": "CPF válido do paciente"
          },
          "birthDate": {
